# Copie este arquivo para .env e preencha a chave.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env
#
# O arquivo .env está no .gitignore e nunca é enviado ao repositório.
#
# Sem a chave o sistema funciona normalmente: a conferência de notas passa a
# usar apenas as verificações determinísticas e a interface informa que a
# análise por IA está indisponível.

ANTHROPIC_API_KEY=

# Opcional — modelo usado na conferência.
# ANTHROPIC_MODEL=claude-opus-5
